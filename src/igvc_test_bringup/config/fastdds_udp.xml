<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <!-- UDPv4: used for cross-host traffic (Docker containers, Jetson bridge) -->
    <transport_descriptor>
      <transport_id>igvc_udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <!-- Shared Memory: zero-copy for all intra-host node communication -->
    <transport_descriptor>
      <transport_id>igvc_shm_transport</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size><!-- 64 MB segment -->
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="igvc_udp_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <!-- SHM first: preferred for local nodes (zero-copy) -->
        <transport_id>igvc_shm_transport</transport_id>
        <!-- UDP fallback: used when SHM peer not reachable (cross-host) -->
        <transport_id>igvc_udp_transport</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
