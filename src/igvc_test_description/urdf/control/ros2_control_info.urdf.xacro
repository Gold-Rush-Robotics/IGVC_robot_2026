<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="hardware_interface" default="IsaacDriveHardware" />


  <xacro:property name="hardware_interface_value" value="$(arg hardware_interface)" />
  
  <xacro:property name="is_can" value="${hardware_interface_value == 'CanInterface'}"/>
  <xacro:property name="is_gz" value="${hardware_interface_value == 'GazeboSimSystem'}"/>

  <ros2_control name="igvc_test_bot" type="system">
    <hardware>
      <xacro:if value="${is_can}">
        <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
        <param name="can">can0</param>
      </xacro:if>
      <xacro:if value="${is_gz}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="${is_can or is_gz}">
        <plugin>grr_hardware/$(arg hardware_interface)</plugin>
      </xacro:unless>
    </hardware>

    <joint name="right_wheel_joint">
      <xacro:if value="${is_can}">
         <param name="node_id">0</param>
      </xacro:if>
      <command_interface name="velocity">
        <param name="min">-22</param>
        <param name="max">22</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_wheel_joint">
      <xacro:if value="${is_can}">
         <param name="node_id">3</param>
      </xacro:if>
      <command_interface name="velocity">
        <param name="min">-22</param>
        <param name="max">22</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename ="libgz_ros2_control-system.so">
      <parameters>$(find igvc_test_bringup)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
